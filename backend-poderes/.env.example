# =====================================================================
# CONFIGURACIÓN POR MÁQUINA — copiar este archivo a `.env` y completar.
#
# `.env` NO se sube al repo (está en .gitignore): cada PC usa el suyo.
# El otro PC debe copiar este ejemplo y poner SU puerto/contraseña.
# =====================================================================

# Motor de base de datos (ahora solo PostgreSQL)
DB_TYPE=postgres

# ---------- PostgreSQL ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=memoria_ninja
PGUSER=postgres
PGPASSWORD=

# Base de datos de PRUEBAS (npm run db:test-setup)
PGDATABASE_TEST=memoria_ninja_test

# ---------- Correo ----------
# MAILER=consola  -> imprime el código en la consola (sin correo real)
# MAILER=ethereal -> Nodemailer contra el boceto de Ethereal (URL de vista previa)
# MAILER=smtp     -> SMTP real (configurar las claves SMTP_*)
MAILER=consola

# --- Solo si MAILER=smtp ---
# Gmail: activar "Verificación en 2 pasos" y crear una "Contraseña de aplicación"
# (16 dígitos SIN espacios). NO uses tu contraseña normal de Gmail.
#   SMTP_SERVICE=gmail   -> nodemailer usa la config recomendada de Gmail
#   o bien host/puerto manuales:
#     SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   SMTP_SECURE=true
#     SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_SECURE=false   (STARTTLS)
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remitente visible (por defecto "Memoria Ninja <SMTP_USER>")
SMTP_FROM=

# ---------- Sesión (cookie httpOnly) ----------
# Duración de la sesión en minutos (14.400 = 1 día)
COOKIE_TTL_MIN=1440

# Bandera Secure de la cookie (Parte 4). SOLO producción con HTTPS: si está
# en 1 y el sitio no es https, el navegador descarta la cookie y el login no
# funciona. En local dejar vacío.
# COOKIE_SECURE=1

# ---------- CORS (Parte 4) ----------
# Orígenes permitidos, separados por coma. El frontend servido por este
# backend va en mismo origen y NO necesita CORS: esto es solo para
# desarrollo externo (p. ej. Live Server en :5500). Cualquier otro origen
# queda bloqueado (sin cabeceras CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Puerto del servidor Express
SERVER_PORT=3000