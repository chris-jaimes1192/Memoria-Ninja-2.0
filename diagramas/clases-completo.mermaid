        -HTMLElement overlay
        -boolean activo
        -#cablearToggle() void
        -#cablearClickOverlay() void
    }

    class PoderGE {
        <<abstract>>
        +string id
        +string nombre
        +number costoChakra
        -object _usos
        -HTMLElement boton
        -HTMLElement contador
        -object contexto
        +inyectarContexto(contexto) void
        +activar() void
        +efecto(contexto, esSasuke, jugador) void
        +estaBloqueado(contexto) boolean
        +validarCondicionesExtra(contexto) boolean
        +usosRestantes(esSasuke) number
        +mostrarMensaje(mensaje) void
    }

    class ByakuganPoderGE {
        -boolean _activo
        +estaBloqueado(contexto) boolean
        +validarCondicionesExtra(contexto) boolean
        +efecto(contexto, esSasuke) void
    }

    class SustitucionPoderGE {
        -object _armada
        -number _timeout
        +estaBloqueado(contexto) boolean
        +estaArmada(esSasuke) boolean
        +desarmar(esSasuke) void
        +efecto(contexto, esSasuke) void
    }

    class RoboPoderGE {
        +efecto(contexto, esSasuke, atacante) void
    }

    class GenjutsuPoderGE {
        -boolean _activo
        -number _timeout
        +estaBloqueado(contexto) boolean
        +estaActivo() boolean
        +cancelar(detectadoPorByakugan) void
        +efecto(contexto) void
    }

    class SelloPoderGE {
        -object _cartaSelladaActual
        -number _timeout
        +estaBloqueado(contexto) boolean
        +validarCondicionesExtra(contexto) boolean
        +efecto() void
    }

    class BombaPoderGE {
        +efecto(contexto, esSasuke) void
    }

    class Personaje {
        +number CHAKRA_MAXIMO$ = 100
        +number VIDA_MAXIMA$ = 100
        -#number chakra
        -#number vida
        -#number combo
        -#number aciertos
        -#number errores
        +get chakra() number
        +get vida() number
        +get combo() number
        +tieneChakraPara(costo) boolean
        +gastarChakra(cantidad) void
        +ganarChakra(cantidad) void
        +recibirDanio(cantidad) void
        +registrarAcierto() void
        +registrarError() boolean
        +estaDerrotado() boolean
    }

    class GestorPoderes {
        +ByakuganPoderGE byakugan
        +SustitucionPoderGE sustitucion
        +RoboPoderGE robo
        +GenjutsuPoderGE genjutsu
        +SelloPoderGE sello
        +BombaPoderGE bomba
        +array poderes
    }

    class GestorTurno {
        -boolean #esTurnoDeSasuke
        -boolean #modoPruebaLocal
        -boolean #miPersonajeEsSasuke
        -array #oyentesDeCambio
        +esTurnoDeSasuke() boolean
        +esMiTurno() boolean
        +alCambiarTurno(callback) void
        +cambiar() void
    }

    class GestorTiempo {
        -number #tiempoSasuke
        -number #tiempoNaruto
        -number #intervalo
        +get tiempoSasuke() number
        +get tiempoNaruto() number
        +iniciar(onTick) void
        +descontarSegundo(esTurnoDeSasuke) boolean
        +detener() void
        +static formatear(segundos) string
    }

    class GestorPartida {
        -Personaje jugador
        -Personaje rival
        -GestorTurno gestorTurno
        -GestorTiempo gestorTiempo
        -GestorPoderes gestorPoderes
        -VistaPartida vista
        -number puntajeActual
        -boolean partidaFinalizada
        +iniciar() void
        +procesarResultado(esAcierto, puntajeTotal) void
        +mostrarModalFinal(movimientos, puntaje) void
    }

    class VistaPartida {
        -HTMLElement timer
        -HTMLElement moves
        -HTMLElement score
        -HTMLElement turnoActual
        +cargarPanelJugador(jugador) void
        +cargarPanelRival(rival) void
        +renderTurno(esTurnoDeSasuke) void
        +renderTiempos(tiempoS, tiempoN, ...) void
        +renderPuntaje(puntaje) void
