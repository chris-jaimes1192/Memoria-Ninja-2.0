classDiagram

    class Poder {
        <<abstract>>
        +string id
        +string nombre
        +number costoChakra
        +number usosPermitidos
        +activar(contexto) object
        +puedeSerContrarrestadoPor(poderRival) boolean
    }

    class ByakuganPoder {
        +activar(jugador, rival, tablero, registrarEvento) object
        +puedeSerContrarrestadoPor(poderRival) boolean
    }

    class SustitucionPoder {
        +activar(jugador, registrarEvento) object
    }

    class RoboChakraPoder {
        +activar(jugador, rival, registrarEvento) object
        +puedeSerContrarrestadoPor(poderRival) boolean
    }

    class GenjutsuPoder {
        +activar(jugador, rival, tablero, registrarEvento) object
        +puedeSerContrarrestadoPor(poderRival) boolean
    }

    class SelloPoder {
        +activar(jugador, tablero, registrarEvento) object
        +puedeSerContrarrestadoPor(poderRival) boolean
    }

    class BombaPoder {
        +activar(jugador, rival, registrarEvento) object
        +puedeSerContrarrestadoPor(poderRival) boolean
    }

    class Jugador {
        -#number chakra
        -#number vida
        -#number chakraMaximo
        -#number vidaMaxima
        +string id
        +string nombre
        +get chakra() number
        +get vida() number
        +tieneChakraPara(costo) boolean
        +gastarChakra(cantidad) void
        +ganarChakra(cantidad) void
        +recibirDanio(cantidad) void
        +estaDerrotado() boolean
    }

    class Partida {
        +string id
        +object jugadores
        +Tablero tablero
        +array eventos
        +object poderesActivos
        +obtenerJugador(idJugador) Jugador
        +obtenerRival(idJugador) Jugador
        +registrarEvento(mensaje) void
        +marcarPoderActivo(idJugador, poder) void
        +poderActivoDe(idJugador) Poder
    }

    class Tablero {
        +array cartasOcultas
        +revelarCartasOcultas(cantidad, options) array
        +desorientarVisualmente(idJugador, options) object
        +bloquearCartaAleatoria(options) number
    }

    class PartidaRepository {
        <<interface>>
        +obtener(idPartida) Partida
        +guardar(idPartida, partida) void
    }

    class PartidaRepositoryMemoria {
        -Map partidas
        +obtener(idPartida) Partida
        +guardar(idPartida, partida) void
    }

    class PartidaRepositoryArchivo {
        -string carpeta
        -Map cacheEnMemoria
        +obtener(idPartida) Partida
        +guardar(idPartida, partida) void
    }

    class PoderFactory {
        <<Factory Method>>
        -Map constructoresPorId
        +registrar(idPoder, ClaseConstructora) void
        +crear(idPoder) Poder
        +idsDisponibles() string[]
    }

    class PoderService {
        -PartidaRepository partidaRepository
        -PoderFactory poderFactory
        +activarPoder(idPartida, idJugador, idPoder) object
    }

    class PoderController {
        -PoderService poderService
        +activarPoder(req, res) void
    }

