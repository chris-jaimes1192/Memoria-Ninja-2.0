    class ProveedorDatos {
        <<abstract>>
        +obtenerDatos() object
    }

    class ProveedorDatosSimulado {
        +obtenerDatos() object
    }

    Poder <|-- ByakuganPoder : Herencia
    Poder <|-- SustitucionPoder : Herencia
    Poder <|-- RoboChakraPoder : Herencia
    Poder <|-- GenjutsuPoder : Herencia
    Poder <|-- SelloPoder : Herencia
    Poder <|-- BombaPoder : Herencia

    Partida *-- Jugador : 2 jugadores
    Partida *-- Tablero : 1 tablero

    PartidaRepository <|.. PartidaRepositoryMemoria : LSP verificado
    PartidaRepository <|.. PartidaRepositoryArchivo : LSP verificado

    PoderService --> PartidaRepository : DIP - depende de interfaz
    PoderService --> PoderFactory : DIP - inyectado por constructor
    PoderController --> PoderService : DIP - inyectado por constructor
    PoderFactory --> Poder : crea instancias nuevas
    PoderService --> Partida : manipula durante activacion
    Partida --> Poder : almacena poderes activos

    FormularioControllerBase <|-- LoginController : Herencia
    FormularioControllerBase <|-- RegistroController : Herencia
    FormularioControllerBase <|-- RecuperacionController : Herencia
    FormularioControllerBase <|-- VerificacionController : Herencia

    AutenticacionService --> IUsuarioLector : DIP - solo lectura
    RegistroService --> IUsuarioLector : DIP
    RegistroService --> IUsuarioEscritor : DIP
    RecuperacionService --> IUsuarioLector : DIP
    RecuperacionService --> IUsuarioEscritor : DIP
    RecuperacionService --> ICodigoGenerador : DIP
    SesionService --> ISesionRepositorio : DIP
    VerificacionService --> ICodigoGenerador : DIP

    LoginController --> AutenticacionService : inyectado
    LoginController --> SesionService : inyectado
    RegistroController --> RegistroService : inyectado
    RecuperacionController --> RecuperacionService : inyectado
    RecuperacionController --> IEnviadorCodigo : inyectado
    VerificacionController --> VerificacionService : inyectado
    VerificacionController --> IEnviadorCodigo : inyectado

    FormularioControllerBase --> INotificador : DIP via super()

    IUsuarioLector <|.. LocalStorageUsuarioRepositorio : LSP
    IUsuarioEscritor <|.. LocalStorageUsuarioRepositorio : LSP
    ISesionRepositorio <|.. LocalStorageSesionRepositorio : LSP
    INotificador <|.. MensajeDomNotificador : LSP
    INotificador <|.. AlertaNotificador : LSP
    ICodigoGenerador <|.. CodigoNumericoGenerador : LSP
    ICodigoGenerador <|.. CodigoAlfanumericoGenerador : LSP
    IEnviadorCodigo <|.. EnvioCodigoModoPrueba : LSP

    EnvioCodigoModoPrueba --> INotificador : usa para mostrar

    BaseModal <|-- ProfileModal : Herencia
    BaseModal <|-- RankingModal : Herencia
    BaseModal <|-- HistoryModal : Herencia
    BaseModal <|-- GameModeModal : Herencia

    IStorageRepository <|.. LocalStorageRepository : LSP
    IProfileService <|.. ProfileService : LSP
    IGameSessionService <|.. GameSessionService : LSP
    ProfileService --> IStorageRepository : DIP
    GameSessionService --> IStorageRepository : DIP
    ProfileModal --> ProfileService : inyectado
    MenuController --> BaseModal : compone modales
    MenuController --> ProfileModal : compone

    VIJugadorRepository <|.. VJugadorRepository : LSP
    VIPartidaRepository <|.. VPartidaRepository : LSP

    VPartida *-- VJugador : 1 jugador
    VPartida o-- Carta : cartasVolteadas
    JuegoService --> VPartida : compone
    JuegoService --> CartaService : inyectado
    JuegoService --> PuntajeService : inyectado
    CartaService --> Carta : crea instancias
    PuntajeService --> VJugador : modifica puntaje
    UzumakiController --> JuegoService : inyectado
    UzumakiController --> CartaService : inyectado
    UzumakiController --> PuntajeService : inyectado
    UzumakiController --> TiempoService : inyectado
    UzumakiController --> VJugador : crea
    UzumakiController --> VPartida : crea

    MuerteController --> JuegoService : inyectado
    MuerteController --> CartaService : inyectado
    MuerteController --> PuntajeService : inyectado
    MuerteController --> TiempoService : inyectado
    MuerteController --> VJugador : crea jugador1
    MuerteController --> VJugador : crea jugador2
    MuerteController --> VPartida : crea

    ArenaController --> JuegoService : inyectado
    ArenaController --> CartaService : inyectado
    ArenaController --> PuntajeService : inyectado
    ArenaController --> TiempoService : inyectado
    ArenaController --> VJugador : crea
    ArenaController --> VPartida : crea

    AkatsukiController --> JuegoService : inyectado
    AkatsukiController --> CartaService : inyectado
    AkatsukiController --> PuntajeService : inyectado
    AkatsukiController --> TiempoService : inyectado
    AkatsukiController --> VJugador : crea
    AkatsukiController --> VPartida : crea

    NieblaController --> JuegoService : inyectado
    NieblaController --> CartaService : inyectado
    NieblaController --> PuntajeService : inyectado
    NieblaController --> TiempoService : inyectado
    NieblaController --> VJugador : crea
    NieblaController --> VPartida : crea

    RepositorioClanes --> ConfiguracionClanes : lee CLANES y DESTINOS_JUEGO
    MapaInteractivo --> ConfiguracionZonas : consume ZONAS
    ModoCoordenadas --> MapaInteractivo : usa escalaActual
    ConfiguracionZonas --> MapaInteractivo : define zonas clickeables
    ConfiguracionClanes --> RepositorioClanes : fuente de datos

    PoderGE <|-- ByakuganPoderGE : Herencia
    PoderGE <|-- SustitucionPoderGE : Herencia
    PoderGE <|-- RoboPoderGE : Herencia
    PoderGE <|-- GenjutsuPoderGE : Herencia
    PoderGE <|-- SelloPoderGE : Herencia
