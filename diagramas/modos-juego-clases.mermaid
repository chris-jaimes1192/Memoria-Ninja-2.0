classDiagram

    class Jugador {
        -string nombre
        -number puntaje
        +sumarPuntos(puntos) void
        +reiniciarPuntaje() void
        +getNombre() string
        +getPuntaje() number
    }

    class Partida {
        -Jugador jugador
        -number movimientos
        -number segundos
        -array cartasVolteadas
        -number cartasEncontradas
        +aumentarMovimientos() void
        +agregarCartaVolteada(carta) void
        +limpiarCartasVolteadas() void
        +obtenerJugador() Jugador
        +reiniciar() void
    }

    class Carta {
        -string id
        -string imagen
        -boolean volteada
        -boolean encontrada
        +voltear() void
        +ocultar() void
        +marcarEncontrada() void
        +getId() string
        +getImagen() string
        +estaVolteada() boolean
        +estaEncontrada() boolean
    }

    class JuegoService {
        -Partida partida
        -CartaService cartaService
        -PuntajeService puntajeService
        +iniciar() array
        +voltearCarta(carta) boolean
        +verificarPareja() boolean
        +finalizarIntento() void
        +aumentarMovimiento() void
        +verificarVictoria(total) boolean
    }

    class CartaService {
        -string rutaBack
        -string rutaAldea
        -array idsCartas
        +obtenerCartas() array
        +mezclar(cartas) array
    }

    class PuntajeService {
        -number puntosPorPareja
        +calcularPuntos() number
        +agregarPuntos(jugador) void
    }

    class TiempoService {
        -number segundos
        -number temporizador
        +iniciar(callback) void
        +detener() void
        +reiniciar(segundos) void
        +obtenerTiempo() number
    }

    class SecuenciaService {
        +generarSecuencia(ids) array
    }

    class IJugadorRepository {
        <<interface>>
        +guardar(jugador) void
        +obtener(nombre) Jugador
    }

    class IPartidaRepository {
        <<interface>>
        +guardar(partida) void
        +obtener() object
    }

    class JugadorRepository {
        +guardar(jugador) void
        +obtener(nombre) Jugador
    }

    class PartidaRepository {
        +guardar(partida) void
        +obtener() object
    }

    class UzumakiController {
        -JuegoService juegoService
        -CartaService cartaService
        -PuntajeService puntajeService
        -TiempoService tiempoService
        +iniciarJuego() void
        +generarTablero(cartas) void
        +seleccionarCarta(cartaDOM) void
        +comprobarPareja() void
        +mostrarVictoria() void
        +mostrarDerrota() void
    }

