    class MuerteController {
        -Jugador jugador1
        -Jugador jugador2
        -Partida partida
        -JuegoService juegoService
        -CartaService cartaService
        -PuntajeService puntajeService
        -TiempoService tiempoService
        +iniciar() void
        +generarTablero() void
        +voltearCarta(elemento, carta) void
        +verificarCoincidencia() void
        +tiempoAgotado() void
        +mostrarVictoria() void
    }

    IJugadorRepository <|.. JugadorRepository : LSP
    IPartidaRepository <|.. PartidaRepository : LSP

    Partida *-- Jugador : 1 jugador
    Partida o-- Carta : cartasVolteadas
    JuegoService --> Partida : compone
    JuegoService --> CartaService : inyectado
    JuegoService --> PuntajeService : inyectado
    CartaService --> Carta : crea instancias
    PuntajeService --> Jugador : modifica puntaje

    UzumakiController --> JuegoService : compone
    UzumakiController --> CartaService
    UzumakiController --> IJugadorRepository : modo con repos
    UzumakiController --> IPartidaRepository : modo con repos
    UchihaController --> JuegoService : compone
    UchihaController --> CartaService
    UchihaController --> IJugadorRepository : modo con repos
    UchihaController --> IPartidaRepository : modo con repos
    HyugaController --> JuegoService : compone
    HyugaController --> CartaService
    HyugaController --> IJugadorRepository : modo con repos
    HyugaController --> IPartidaRepository : modo con repos
    SarutobiController --> JuegoService : compone
    SarutobiController --> CartaService
    SarutobiController --> IJugadorRepository : modo con repos
    SarutobiController --> IPartidaRepository : modo con repos
    RocaController --> JuegoService : compone
    RocaController --> CartaService
    NubeController --> JuegoService : compone
    NubeController --> CartaService
    OrdenController --> JuegoService : compone
    OrdenController --> SecuenciaService : en vez de CartaService
    OrdenController --> IJugadorRepository : modo con repos
    OrdenController --> IPartidaRepository : modo con repos
    ArenaController --> JuegoService : compone
    ArenaController --> CartaService
    AkatsukiController --> JuegoService : compone
    AkatsukiController --> CartaService
    NieblaController --> JuegoService : compone
    NieblaController --> CartaService
    MuerteController --> JuegoService : compone
    MuerteController --> CartaService
    MuerteController --> IJugadorRepository : modo con repos
    MuerteController --> IPartidaRepository : modo con repos

    UzumakiController --> Jugador : crea
    UzumakiController --> Partida : crea
    UchihaController --> Jugador : crea
    UchihaController --> Partida : crea
    HyugaController --> Jugador : crea
    HyugaController --> Partida : crea
    SarutobiController --> Jugador : crea
    SarutobiController --> Partida : crea
    RocaController --> Jugador : crea
    RocaController --> Partida : crea
    NubeController --> Jugador : crea
    NubeController --> Partida : crea
    OrdenController --> Jugador : crea
    OrdenController --> Partida : crea
    ArenaController --> Jugador : crea
    ArenaController --> Partida : crea
    AkatsukiController --> Jugador : crea
    AkatsukiController --> Partida : crea
    NieblaController --> Jugador : crea
    NieblaController --> Partida : crea
    MuerteController --> Jugador : crea (modo 2 jugadores)
    MuerteController --> Partida : crea con jugador1 y jugador2